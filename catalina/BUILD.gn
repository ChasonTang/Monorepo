# Binary compatibility shims for macOS Catalina. Consumers redirect load commands
# to these dylibs and rely on their whole-library re-exports. The system shims
# remain dylibs even when ordinary Monorepo components are static.
assert(current_os == "mac" && current_cpu == "x64",
       "Catalina compatibility shims require macOS x64.")

shared_library("catalina_cxx") {
  sources = [ "iostream_compat.cpp" ]

  # C++20 changes the str() overload set; retain the ABI used by the binary.
  cflags_cc = [ "-std=c++17" ]
  configs += [
    "//build:rtti",
    "//build:exceptions",
    "//build:visibility_default",
  ]

  # Resolve via the target SDK instead of a host library path.
  ldflags = [ "-Wl,-reexport-lc++" ]
}

shared_library("catalina_system") {
  sources = [ "system_compat.c" ]
  configs += [ "//build:visibility_default" ]
  ldflags = [ "-Wl,-reexport-lSystem" ]
}

# Whole-library ICU re-exports require the component dylibs, not static archives.
if (is_component_build) {
  shared_library("catalina_icu") {
    sources = [ "icu_reexport.c" ]
    configs += [ "//build:visibility_default" ]

    deps = [
      "//icu:icui18n",
      "//icu:icuuc",
    ]
    lib_dirs = [ root_out_dir ]
    ldflags = [
      "-Wl,-reexport-licui18n",
      "-Wl,-reexport-licuuc",

      # The anchor makes no ICU calls; retain both under -dead_strip_dylibs.
      "-Wl,-needed-licui18n",
      "-Wl,-needed-licuuc",
    ]
  }
}

group("catalina") {
  deps = [
    ":catalina_cxx",
    ":catalina_system",
  ]
  if (is_component_build) {
    deps += [ ":catalina_icu" ]
  }
}
