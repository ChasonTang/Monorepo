# The location of the build configuration file.
buildconfig = "//build/BUILDCONFIG.gn"

# The secondary source root is a parallel directory tree where
# GN build files are placed when they can not be placed directly
# in the source tree, e.g. for third party source trees.
secondary_source = "//build/secondary/"

# Check first-party code, including tests, with "gn check" or "gn gen --check".
# Third-party sources keep their upstream layout and are not checked themselves.
check_targets = [
  "//argcv/*",
  "//odin/*",
  "//ipsw/*",
]

# Also validate dependencies included with <angle brackets> (e.g. gtest).
check_system_includes = true

# Run all GN action() scripts through python3. Without this, GN would search
# $PATH for "python", which is absent on systems that ship only python3.
script_executable = "python3"
