# odin GN build (RFC-001 codec + RFC-002 single-binary CLI skeleton).
#
# Targets:
#   :odin                — CLI parser/entry point plus production runtimes.
#   :odin_core           — protocol/helpers and shared CLI declarations.
#   :odin_main           — executable wrapping odin_cli_main; output_name is
#                          "odin" so the produced binary is out/odin. (Named
#                          :odin_main because :odin already labels the
#                          source_set.)
#   :odin_symlinks       — GN action that creates relative symlinks
#                          out/odin-client and out/odin-server pointing to
#                          basename "odin". Intentionally has no deps on
#                          :odin_main: link contents depend only on script
#                          and link/target paths, so relinking out/odin
#                          must not re-run the action.
#   :odin_cli_artifacts  — group bundling :odin_main + :odin_symlinks.
#
# Test targets live in //odin/testing:BUILD.gn (notably :odin_unittests
# and :odin_event_loop_testing).

source_set("odin_core") {
  public = [
    "cli.h",
    "client_listen.h",
    "host_addr.h",
    "http_connect.h",
    "parse_util.h",
    "protocol.h",
  ]
  sources = [
    "client_listen.c",
    "host_addr.c",
    "http_connect.c",
    "parse_util.c",
    "protocol.c",
  ]
}

source_set("odin") {
  # cli.c dispatches to the client/server runtimes, which themselves depend on
  # odin_core. Keep the entry point above those runtimes to avoid a cycle.
  sources = [ "cli.c" ]
  public = []
  public_deps = [ ":odin_core" ]

  deps = [
    ":odin_accept_loop",
    ":odin_cli_client",
    ":odin_cli_server",
    ":odin_client_xqc_runtime",
    ":odin_connect_session",
    ":odin_dial",
    ":odin_dns_resolver",
    ":odin_event_loop",
    ":odin_relay",
    ":odin_server_session",
    ":odin_server_xqc_runtime",
    ":odin_transport",
    ":odin_transport_fd",
    ":odin_transport_xqc",
    ":odin_udp",
    ":odin_xqc_udp",
  ]
}

source_set("odin_cli_client") {
  public = [ "cli_client.h" ]
  sources = [ "cli_client.c" ]

  public_deps = [
    ":odin_accept_loop",
    ":odin_client_xqc_runtime",
    ":odin_core",
    ":odin_dns_resolver",
    ":odin_event_loop",
  ]
}

source_set("odin_client_session") {
  public = [ "client_session.h" ]
  sources = [ "client_session.c" ]

  public_deps = [
    ":odin_connect_session",
    ":odin_core",
    ":odin_event_loop",
    ":odin_relay",
    ":odin_transport",
    ":odin_transport_fd",
  ]
}

source_set("odin_client_xqc_runtime") {
  public = [ "client_xqc_runtime.h" ]
  sources = [ "client_xqc_runtime.c" ]

  public_deps = [
    ":odin_client_session",
    ":odin_event_loop",
    ":odin_transport_xqc",
    ":odin_xqc_udp",
    "//boringssl:crypto",
    "//xquic",
  ]
}

source_set("odin_cli_server") {
  public = [ "cli_server.h" ]
  sources = [ "cli_server.c" ]

  public_deps = [
    ":odin_core",
    ":odin_event_loop",
    ":odin_server_xqc_runtime",
  ]
}

source_set("odin_event_loop") {
  public = [ "event_loop.h" ]
  sources = [ "event_loop.c" ]

  if (target_os == "linux") {
    libs = [ "pthread" ]
  }
}

source_set("odin_dns_resolver") {
  public = [ "dns_resolver.h" ]
  sources = [ "dns_resolver.c" ]

  public_deps = [
    ":odin_event_loop",
    "//c-ares:cares",
  ]
}

source_set("odin_udp") {
  public = [ "udp.h" ]
  sources = [ "udp.c" ]

  public_deps = [ ":odin_event_loop" ]
}

source_set("odin_relay") {
  public = [ "relay.h" ]
  sources = [ "relay.c" ]

  public_deps = [ ":odin_transport" ]
}

source_set("odin_server_session") {
  public = [ "server_session.h" ]
  sources = [ "server_session.c" ]

  public_deps = [
    ":odin_connect_session",
    ":odin_dial",
    ":odin_dns_resolver",
    ":odin_event_loop",
    ":odin_relay",
    ":odin_transport",
    ":odin_transport_fd",
  ]
}

source_set("odin_server_xqc_runtime") {
  public = [ "server_xqc_runtime.h" ]
  sources = [ "server_xqc_runtime.c" ]

  public_deps = [
    ":odin_event_loop",
    ":odin_server_session",
    ":odin_transport_xqc",
    ":odin_xqc_udp",
    "//xquic",
  ]
}

source_set("odin_connect_session") {
  public = [ "connect_session.h" ]
  sources = [ "connect_session.c" ]

  public_deps = [
    ":odin_core",
    ":odin_transport",
  ]
}

source_set("odin_dial") {
  public = [ "dial.h" ]
  sources = [ "dial.c" ]

  public_deps = [ ":odin_event_loop" ]
}

source_set("odin_accept_loop") {
  public = [ "accept_loop.h" ]
  sources = [ "accept_loop.c" ]

  public_deps = [ ":odin_event_loop" ]
}

source_set("odin_transport") {
  public = [ "transport.h" ]
  sources = [ "transport.c" ]
}

source_set("odin_transport_fd") {
  public = [ "transport_fd.h" ]
  sources = [ "transport_fd.c" ]

  public_deps = [
    ":odin_event_loop",
    ":odin_transport",
  ]
}

source_set("odin_transport_xqc") {
  public = [ "transport_xqc.h" ]
  sources = [ "transport_xqc.c" ]

  public_deps = [
    ":odin_transport",
    "//xquic",
  ]
}

source_set("odin_xqc_udp") {
  public = [ "xqc_udp.h" ]
  sources = [ "xqc_udp.c" ]

  public_deps = [
    ":odin_event_loop",
    ":odin_udp",
    "//xquic",
  ]
}

action("odin_transport_xqc_scope_check") {
  script = "check_xqc_stream_transport_scope.py"

  inputs = [
    "transport_xqc.c",
    "transport_xqc.h",
    "BUILD.gn",
  ]

  outputs = [ "$target_gen_dir/odin_transport_xqc_scope_check.stamp" ]

  args = [
    "--root",
    rebase_path("//", root_build_dir),
    "--stamp",
    rebase_path(outputs[0], root_build_dir),
  ]
}

action("odin_client_xqc_runtime_scope_check") {
  script = "check_client_xqc_runtime_scope.py"

  inputs = [
    "cli_client.c",
    "cli_client.h",
    "client_session.c",
    "client_xqc_runtime.c",
    "client_xqc_runtime.h",
    "BUILD.gn",
  ]

  outputs = [ "$target_gen_dir/odin_client_xqc_runtime_scope_check.stamp" ]

  args = [
    "--root",
    rebase_path("//", root_build_dir),
    "--stamp",
    rebase_path(outputs[0], root_build_dir),
  ]
}

executable("odin_main") {
  output_name = "odin"

  sources = [ "main.c" ]

  deps = [ ":odin" ]

  if (target_os == "linux") {
    configs += [ "//build:visibility_default" ]
  }
}

action("odin_symlinks") {
  script = "//build/symlink.py"

  outputs = [
    "$root_out_dir/odin-client",
    "$root_out_dir/odin-server",
  ]

  args = [
    "--target",
    "odin",
    "--link",
    rebase_path("$root_out_dir/odin-client", root_build_dir),
    "--link",
    rebase_path("$root_out_dir/odin-server", root_build_dir),
  ]
}

group("odin_cli_artifacts") {
  deps = [
    ":odin_main",
    ":odin_symlinks",
  ]
}
