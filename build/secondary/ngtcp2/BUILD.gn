# GN build for ngtcp2 v1.25.0 with the BoringSSL backend.
# Source lists mirror lib/CMakeLists.txt and crypto/boringssl/CMakeLists.txt.
# Transport and TLS helper sources share one target; BoringSSL is the
# Monorepo's TLS backend.
# No HTTP/3, nghttp3, examples, or other TLS backends are built.

import("//build/component.gni")

config("ngtcp2_public_config") {
  include_dirs = [
    # Pre-generated version.h; keep it in sync with the pinned submodule.
    "//build/secondary/ngtcp2/include",
    "crypto/includes",
    "lib/includes",
  ]

  # component() becomes a source_set in release; consumers must use the same
  # export declarations as the library.
  if (!is_debug) {
    defines = [ "NGTCP2_STATICLIB" ]
  }
}

config("ngtcp2_internal_config") {
  include_dirs = [
    "crypto",
    "lib",
  ]
  defines = [
    "BUILDING_NGTCP2",
    "HAVE_ARPA_INET_H=1",
    "HAVE_NETINET_IN_H=1",
    "HAVE_UNISTD_H=1",
  ]

  # These macros describe capabilities of the supported SDKs/sysroot. All
  # supported CPUs are little-endian, so WORDS_BIGENDIAN stays undefined.
  # Pass macros directly instead of requiring an upstream-generated config.h.
  if (current_os == "linux") {
    defines += [
      "HAVE_BYTESWAP_H=1",
      "HAVE_DECL_BE64TOH=1",
      "HAVE_DECL_BSWAP_64=1",
      "HAVE_ENDIAN_H=1",
      "HAVE_EXPLICIT_BZERO=1",
    ]
  } else {
    # macOS and iOS provide be64toh/htobe64 through sys/endian.h.
    # Use that header explicitly: iOS's legacy Endian.h can also match
    # endian.h on case-insensitive filesystems.
    defines += [
      "HAVE_DECL_BE64TOH=1",
      "HAVE_DECL_BSWAP_64=0",
      "HAVE_MEMSET_S=1",
      "HAVE_SYS_ENDIAN_H=1",
    ]
  }

  # Upstream keeps assertions enabled in every build type (CMakeLists.txt).
  cflags_c = [ "-UNDEBUG" ]
}

component("ngtcp2") {
  public_configs = [ ":ngtcp2_public_config" ]
  configs += [ ":ngtcp2_internal_config" ]

  public = [
    "//build/secondary/ngtcp2/include/ngtcp2/version.h",
    "crypto/includes/ngtcp2/ngtcp2_crypto.h",
    "crypto/includes/ngtcp2/ngtcp2_crypto_boringssl.h",
    "lib/includes/ngtcp2/ngtcp2.h",
  ]

  sources = [
    "crypto/boringssl/boringssl.c",
    "crypto/shared.c",
    "crypto/shared.h",
    "lib/ngtcp2_acktr.c",
    "lib/ngtcp2_acktr.h",
    "lib/ngtcp2_addr.c",
    "lib/ngtcp2_addr.h",
    "lib/ngtcp2_balloc.c",
    "lib/ngtcp2_balloc.h",
    "lib/ngtcp2_bbr.c",
    "lib/ngtcp2_bbr.h",
    "lib/ngtcp2_buf.c",
    "lib/ngtcp2_buf.h",
    "lib/ngtcp2_callbacks.c",
    "lib/ngtcp2_callbacks.h",
    "lib/ngtcp2_cc.c",
    "lib/ngtcp2_cc.h",
    "lib/ngtcp2_cid.c",
    "lib/ngtcp2_cid.h",
    "lib/ngtcp2_conn.c",
    "lib/ngtcp2_conn.h",
    "lib/ngtcp2_conn_info.c",
    "lib/ngtcp2_conn_info.h",
    "lib/ngtcp2_conn_stat.h",
    "lib/ngtcp2_conv.c",
    "lib/ngtcp2_conv.h",
