# Keep source lists in upstream BoringSSL. GN evaluates this secondary file
# relative to //boringssl, matching the paths in sources.gni.
import("//boringssl/gen/sources.gni")
import("//build/component.gni")

config("boringssl_public_config") {
  include_dirs = [ "include" ]

  # Match component() and propagate the shared-library mode to consumers.
  if (is_debug) {
    defines = [ "BORINGSSL_SHARED_LIBRARY" ]
  }
}

config("boringssl_config") {
  # Keep implementation-side export annotations private to BoringSSL.
  defines = [ "BORINGSSL_IMPLEMENTATION" ]
}

component("crypto") {
  public_configs = [ ":boringssl_public_config" ]

  configs += [
    ":boringssl_config",
    "//build:no_unused_parameter",
  ]

  sources = bcm_sources + bcm_sources_asm + crypto_sources +
            crypto_sources_asm + bcm_internal_headers + crypto_internal_headers

  public = crypto_headers

  if (target_os == "linux") {
    libs = [ "pthread" ]
  }
}

component("ssl") {
  public_configs = [ ":boringssl_public_config" ]

  configs += [
    ":boringssl_config",
    "//build:no_unused_parameter",
  ]

  sources = ssl_sources + ssl_internal_headers

  public = ssl_headers

  deps = [ ":crypto" ]
}
