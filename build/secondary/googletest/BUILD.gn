# Use upstream's aggregate sources so upgrades do not require maintaining an
# individual implementation file list.
config("gtest_public_config") {
  include_dirs = [ "googletest/include" ]
}

config("gmock_public_config") {
  include_dirs = [ "googlemock/include" ]
}

source_set("gtest") {
  testonly = true
  sources = [ "googletest/src/gtest-all.cc" ]

  # gtest-all.cc includes implementation files relative to this directory.
  include_dirs = [ "googletest" ]
  public_configs = [ ":gtest_public_config" ]

  if (current_os == "linux") {
    libs = [ "pthread" ]
  }
}

source_set("gmock") {
  testonly = true
  sources = [ "googlemock/src/gmock-all.cc" ]

  # gmock-all.cc includes implementation files relative to this directory.
  include_dirs = [ "googlemock" ]
  public_configs = [ ":gmock_public_config" ]
  public_deps = [ ":gtest" ]
}

source_set("gtest_main") {
  testonly = true
  sources = [ "googletest/src/gtest_main.cc" ]
  public_deps = [ ":gtest" ]
}

source_set("gmock_main") {
  testonly = true
  sources = [ "googlemock/src/gmock_main.cc" ]
  public_deps = [ ":gmock" ]
}
